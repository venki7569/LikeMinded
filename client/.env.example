# Base URL of the LikeMinded API.
# Left as a relative path in development so Vite's proxy handles it and the
# httpOnly refresh cookie stays same-origin.
VITE_API_URL=/api/v1

# In production point this at the deployed API, e.g.
# VITE_API_URL=https://likeminded-api.onrender.com/api/v1

VITE_APP_NAME=LikeMinded
