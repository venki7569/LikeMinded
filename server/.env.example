# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ─── Client ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
CLIENT_ORIGINS=http://localhost:5173
# Base URL used to build links inside verification / reset emails.
CLIENT_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/likeminded
MONGODB_URI=mongodb://127.0.0.1:27017/likeminded

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SECRET=replace-me-with-another-long-random-string
# Set to true only when served over HTTPS.
COOKIE_SECURE=false

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development to log emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="LikeMinded <no-reply@likeminded.app>"

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# ─── AI microservice ──────────────────────────────────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=8000
