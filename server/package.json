{
  "name": "@likeminded/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LikeMinded REST API — Express + MongoDB",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:memory": "node scripts/startWithMemoryDb.js",
